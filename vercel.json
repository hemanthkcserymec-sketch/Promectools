    {
      "source": "/account/:path*",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account/:path*"
    },
    {
      "source": "/profile",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account?tab=profile"
    },
    {
      "source": "/orders",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account?tab=orders"
    },
    {
      "source": "/track",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account?tab=orders"
    },
    {
      "source": "/order/:path*",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account?orderId=:path*"
    },
    {
      "source": "/privacy-policy",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/privacy-policy"
    },
    {
      "source": "/privacy",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/privacy-policy"
    },
    {
      "source": "/terms-of-use",
