{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/aquaforceforautocare",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare"
    },
    {
      "source": "/aquaforceforautocare/:path*",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/:path*"
    },
    {
      "source": "/aquaforceforservicepartner",
      "destination": "https://promec-gig-workers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/aquaforceforservicepartner/:path*",
      "destination": "https://promec-gig-workers.vercel.app/aquaforceforgigworkers/:path*"
    },
    {
      "source": "/servicepartner",
      "destination": "https://promec-gig-workers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/aquaforceforgigworkers",
      "destination": "https://promec-gig-workers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/aquaforceforgigworkers/:path*",
      "destination": "https://promec-gig-workers.vercel.app/aquaforceforgigworkers/:path*"
    },
    {
      "source": "/inquiryform",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/inquiryform"
    },
    {
      "source": "/inquiryform/:path*",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/inquiryform/:path*"
    },
    {
      "source": "/homecare",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/inquiryform?category=Home+Care"
    },
    {
      "source": "/corporatecare",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/inquiryform?category=Corporate+%26+Facility+Care"
    },
    {
      "source": "/account",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account"
    },
    {
      "source": "/account/:path*",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account/:path*"
    },
    {
      "source": "/profile",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account?tab=profile"
    },
    {
      "source": "/orders",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account?tab=orders"
    },
    {
      "source": "/track",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account?tab=orders"
    },
    {
      "source": "/order/:path*",
      "destination": "https://promec-autocare.vercel.app/aquaforceforautocare/account?orderId=:path*"
    }
  ]
}
