{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/aquaforceforautocare",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare"
    },
    {
      "source": "/aquaforceforautocare/:path*",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/api/:path*"
    },
    {
      "source": "/aquaforceforservicepartner",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/aquaforceforservicepartner/:path*",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers/:path*"
    },
    {
      "source": "/servicepartner",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/servicepartner/:path*",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers/:path*"
    },
    {
      "source": "/aquaforceforgigworkers",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers"
    },
    {
      "source": "/aquaforceforgigworkers/:path*",
      "destination": "https://aquaforceforgigworkers.vercel.app/aquaforceforgigworkers/:path*"
    },
    {
      "source": "/inquiryform",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/inquiryform"
    },
    {
      "source": "/inquiryform/:path*",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/inquiryform/:path*"
    },
    {
      "source": "/homecare",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/inquiryform?category=Home+Care"
    },
    {
      "source": "/corporatecare",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/inquiryform?category=Corporate+%26+Facility+Care"
    },
    {
      "source": "/account",
      "destination": "https://aquaforceautocare.vercel.app/aquaforceforautocare/account"
